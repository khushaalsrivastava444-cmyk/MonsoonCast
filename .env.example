# MonsoonCast Environment Configuration
# Copy this file to .env and adjust local paths if required

# Data root directories
MONSOONCAST_DATA_DIR=data
MONSOONCAST_ARTIFACTS_DIR=artifacts

# IMD Raw Gridded NetCDF directory (0.25 deg daily rainfall)
IMD_NETCDF_DIR=data/raw/imd

# ERA5 atmospheric reanalysis directory (optional)
ERA5_NETCDF_DIR=data/raw/era5

# API Configuration
MONSOONCAST_API_HOST=0.0.0.0
MONSOONCAST_API_PORT=8000
MONSOONCAST_API_DEBUG=False

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
